from funciones import *


def main():
    lst_titulos = []
    lst_generos = []
    lst_duraciones = []
    lst_salas = []
    lst_entradas = []
    lst_valores = []
    lst_estados = []

    opciones_menu()
    n = int(input("Ingrese una opcion:")) # Corregir, tira dos veces seleccionar
    ingresar_opcion(n)
    while n != 5:

        if n == 1:
            print("Funcionalidad pendiente")  # Registrar
        elif n == 2:
            print("Funcionalidad pendiente")  # Eliminar
        elif n == 3:
            print("Funcionalidad pendiente")  # Modificar
        elif n == 4:
            print("Funcionalidad pendiente")  # Informe General

        opciones_menu()
        n = ingresar_opcion(n)
    print("Gracias por usar CineVerse Complex")


main()
