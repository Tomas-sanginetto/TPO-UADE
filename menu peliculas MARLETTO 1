lista_peliculas = ["El Padrino", "El Señor de los Anillos", "Titanic", "Avatar", "Avengers: Endgame", "Jurassic Park", "The Matrix", "El caballero oscuro", "Interstellar", "Dune"]
#FUNCION MENU DE PELICULAS
def menu_peliculas(lista_peliculas):
    #Rango segun la cantidad de elemento de la lista de peliculas
    for i in range(len(lista_peliculas)):
        #i+1 para no mostrar el cero de la lista. {lista_peliculas[i]} Printea el nombre de la pelicula segun la lista
        print(f"{i+1}. {lista_peliculas[i]}")
    opcion= int(input('Seleccione una pelicula:'))
    return opcion -1
    #opcion -1 para que vuelva a su valor de la lista (para poder mostrarlo sin que se salga del rango)



indice=menu_peliculas(lista_peliculas)
print(f"Elegiste:{lista_peliculas[indice]}")

