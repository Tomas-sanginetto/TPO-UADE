def gestionar_generos(lst_titulos, lst_generos, lst_generos_disponibles):
    opciones = ["Registrar nuevo genero", "Modificar generos de una pelicula", "Eliminar un genero del catalogo", "Volver al menu principal"]
    indice = seleccionar_opcion(opciones, "Gestion de generos - Que desea hacer?")
    while indice != 3:
        if indice == 0:
            crear_genero_nuevo(lst_generos_disponibles)
            print("Genero registrado con exito!")
        elif indice == 1:
            modificar_generos_pelicula(lst_titulos, lst_generos, lst_generos_disponibles)
        elif indice == 2:
            eliminar_genero_catalogo(lst_generos_disponibles, lst_generos)
        indice = seleccionar_opcion(opciones, "Gestion de generos - Que desea hacer?")


def eliminar_genero_catalogo(lst_generos_disponibles, lst_generos):
    if len(lst_generos_disponibles) == 0:
        print("No existen generos disponibles!")
        return 

    indice = seleccionar_opcion(lst_generos_disponibles, "Seleccione el genero a eliminar del catalogo:")
    genero = lst_generos_disponibles[indice]
    en_uso = False
    for i in range(len(lst_generos)):
        if genero in lst_generos[i]:
            en_uso = True
    if en_uso:
        print("No se puede eliminar: hay peliculas que usan ese genero.")
    else:
        lst_generos_disponibles.pop(indice)
        print("Genero eliminado del catalogo con exito!")


def modificar_generos_pelicula(lst_titulos, lst_generos, lst_generos_disponibles):
    if len(lst_titulos) == 0:
        print("No hay peliculas registradas!")
        return # Anticipado para cortar las instrucciones de la funcion

    indice_pelicula = ingresar_titulo("Seleccione la pelicula:", lst_titulos)
    opciones = ["Agregar genero", "Quitar genero", "Volver al menu de generos"]
    indice = seleccionar_opcion(opciones, "Que desea hacer?")
    while indice != 2:  # 2 = ultimo indice de "opciones" (len(opciones) - 1)
        if indice == 0:
            agregar_genero_pelicula(lst_generos, lst_generos_disponibles, indice_pelicula)
        elif indice == 1:
            quitar_genero_pelicula(lst_generos, indice_pelicula)
        indice = seleccionar_opcion(opciones, "Que desea hacer?") # Dentro del while porque sino seria un ciclo infinito


def agregar_genero_pelicula(lst_generos, lst_generos_disponibles, indice_pelicula):
    generos_disponibles_pelicula = []
    for i in range(len(lst_generos_disponibles)):
        if lst_generos_disponibles[i] not in lst_generos[indice_pelicula]: # Revisa 1x1 los elementos internamente
            generos_disponibles_pelicula.append(lst_generos_disponibles[i])

    generos_disponibles_pelicula.append("Agregar nuevo genero")
    indice = seleccionar_opcion(generos_disponibles_pelicula, "Seleccione el genero a agregar:")
    if indice == len(generos_disponibles_pelicula) - 1:
        nuevo = crear_genero_nuevo(lst_generos_disponibles)
        lst_generos[indice_pelicula].append(nuevo)
    else:
        lst_generos[indice_pelicula].append(generos_disponibles_pelicula[indice])
    print("Genero agregado con exito!")

    
def quitar_genero_pelicula(lst_generos, indice_pelicula):
    if len(lst_generos[indice_pelicula]) <= 1:
        print("La pelicula debe tener al menos un genero, no se puede quitar")
        return
    
    indice = seleccionar_opcion(lst_generos[indice_pelicula], "Seleccione el genero a quitar:")
    genero_elegido = lst_generos[indice_pelicula][indice]
    confirmacion = input(f"Esta seguro que desea quitar el genero '{genero_elegido}'? (S/N): ")
    while confirmacion.upper() != "S" and confirmacion.upper() != "N":
        print("Opcion invalida.")
        confirmacion = input("Esta seguro? (S/N): ")
    if confirmacion.upper() == "S":
        lst_generos[indice_pelicula].pop(indice)
        print("Genero eliminado con exito!")
    else:
        print("Eliminacion cancelada.")

def crear_genero_nuevo(lst_generos_disponibles):
    '''Valida que no se ingrese un genero vacio ni repetido y lo agrega a la pelicula'''
    nombre = input("Ingrese el nuevo genero:")
    while nombre == "" or genero_existe(nombre, lst_generos_disponibles):
        if nombre == "":
            print("No puede ser un genero vacio, ingrese nuevamente!")
        else:
            print("Genero ya existente")
        nombre = input("Intente con otro genero:")
    lst_generos_disponibles.append(nombre)
    return nombre


# Muy parecida a titulo_existe pero con generos
def genero_existe(genero, lst_generos_disponibles):
    '''Valida que no haya un genero repetido'''
    genero = genero.strip().lower()
    for i in range(len(lst_generos_disponibles)):
        if lst_generos_disponibles[i].strip().lower() == genero:
            return True
    return False 


def seleccionar_opcion(lista, mensaje):
    '''Muestra la lista numerada junto con un mensaje, valida que el usuario
    ingrese un numero dentro del rango valido y retorna el indice
    correspondiente a la opcion elegida'''
    print(mensaje)
    for i in range(len(lista)):
        print(f"{i + 1} {lista[i]}") # Muestra el valor humano y el indice "Lenguaje Python (El 1 es el cero)"
    num = input("Ingrese el numero: ")
    while num.isdigit() == False or int(num) < 1 or int(num) > len(lista):
        print("Numero invalido, intentelo nuevamente")
        num = input("Ingrese el numero: ")
    return int(num) - 1 # Menos 1, por el indice inicial de las listas de Python [0]
